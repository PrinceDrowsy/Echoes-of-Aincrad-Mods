<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cardinal.Core\Cardinal.Core.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Building mods runs retoc and repak from beside the test assembly, as it does from beside Cardinal.exe. -->
  <PropertyGroup>
    <RetocExe Condition="'$(RetocExe)' == ''">$(MSBuildThisFileDirectory)..\..\..\tools\retoc\retoc.exe</RetocExe>
    <RepakExe Condition="'$(RepakExe)' == ''">$(MSBuildThisFileDirectory)..\..\..\tools\repak\repak.exe</RepakExe>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RetocExe)" Link="retoc.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RetocExe)')" />
    <None Include="$(RepakExe)" Link="repak.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RepakExe)')" />
  </ItemGroup>

</Project>
