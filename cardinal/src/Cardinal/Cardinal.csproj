<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A console exe so command-line runs block and print like any CLI; the window hides it for double-click launches. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>Cardinal.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.3.0</Version>
    <Product>Cardinal</Product>
    <AssemblyTitle>Cardinal - The Cardinal System</AssemblyTitle>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native DLLs stay beside the exe; bundling them would unpack them into %TEMP% on every new version. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cardinal.Core\Cardinal.Core.csproj" />
  </ItemGroup>

  <!-- retoc (MIT) builds the mods and ships beside Cardinal.exe. It isn't committed; point RetocExe at a copy if it lives elsewhere. -->
  <PropertyGroup>
    <RetocExe Condition="'$(RetocExe)' == ''">$(MSBuildThisFileDirectory)..\..\..\tools\retoc\retoc.exe</RetocExe>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(RetocExe)')">
    <None Include="$(RetocExe)" Link="retoc.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
