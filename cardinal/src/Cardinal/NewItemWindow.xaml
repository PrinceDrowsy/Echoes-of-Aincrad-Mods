<Window x:Class="Cardinal.NewItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New item" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock FontWeight="Bold" Text="ID" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="Items of this kind are told apart by their ID. The next free one is filled in." />
        <TextBox x:Name="IdBox" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left" />

        <TextBlock FontWeight="Bold" Text="Name (English)" />
        <TextBox x:Name="NameBox" Margin="0,4,0,12" />

        <TextBlock FontWeight="Bold" Text="Description (English)" />
        <TextBox x:Name="DescriptionBox" Margin="0,4,0,12" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12">
            Every other language shows the English until you translate it: the new lines appear on the Text tab, where you can
            write them like any other line. Its icon stays the copied item's, since a new icon needs The Seed, Cardinal's Unreal kit.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add to the mod" IsDefault="True" Padding="12,4" Margin="0,0,8,0" Click="AddClicked" />
            <Button Content="Cancel" IsCancel="True" Padding="12,4" />
        </StackPanel>
    </StackPanel>
</Window>
