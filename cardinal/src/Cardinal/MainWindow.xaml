<Window x:Class="Cardinal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cardinal"
        Title="Cardinal - The Cardinal System" Width="1280" Height="800" MinWidth="800" MinHeight="500">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <Button Content="Copy diagnostic info" Padding="8,0" Click="CopyDiagnostics"
                        ToolTip="Copies Cardinal's version, the game's version, your setup and installed mods for a bug report. Never includes your key or where things are on your PC." />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="Status" Text="Set up the game files to begin." />
            </StatusBarItem>
        </StatusBar>
        <TabControl x:Name="Tabs" SelectionChanged="TabChanged">

            <TabItem Header="Setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                            Cardinal reads your own copy of Echoes of Aincrad. It never changes the game's files and doesn't come with any of them,
                            so it needs three things from you. They're saved on this PC only.
                        </TextBlock>

                        <TextBlock FontWeight="Bold" Text="Game Paks folder" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="EchoesofAincrad\Content\Paks inside the game's install folder. Detect looks in your Steam libraries." />
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse..." Margin="4,0,0,0" Padding="8,2" Click="BrowsePaks" />
                            <Button DockPanel.Dock="Right" Content="Detect" Margin="4,0,0,0" Padding="8,2" Click="DetectPaks" />
                            <TextBox x:Name="PaksBox" />
                        </DockPanel>

                        <TextBlock FontWeight="Bold" Text="AES key" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray">
                            The game's files are encrypted. Cardinal doesn't include the key: run AESDumpster on the game's
                            EchoesofAincrad-Win64-Shipping.exe and paste the key it prints (64 hex digits, with or without 0x).
                        </TextBlock>
                        <TextBox x:Name="KeyBox" Margin="0,4,0,12" FontFamily="Consolas" />

                        <TextBlock FontWeight="Bold" Text="Mappings (.usmap)" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray">
                            Describes the game's data layout. Install the Cardinal Mappings companion mod and start the game once, and Cardinal fills this in by itself. Or make one with UE4SS (DumpUSMAP) and choose it here.
                        </TextBlock>
                        <DockPanel Margin="0,4,0,12">
                            <Button DockPanel.Dock="Right" Content="Browse..." Margin="4,0,0,0" Padding="8,2" Click="BrowseMappings" />
                            <TextBox x:Name="MappingsBox" />
                        </DockPanel>

                        <TextBlock FontWeight="Bold" Text="Oodle library" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray">
                            The game's files are compressed with Oodle, and Cardinal can't ship it. Download fetches it from the OodleUE builds on GitHub,
                            as FModel does, or choose an oo2core or oodle-data-shared DLL you already have.
                        </TextBlock>
                        <DockPanel Margin="0,4,0,16">
                            <Button DockPanel.Dock="Right" Content="Browse..." Margin="4,0,0,0" Padding="8,2" Click="BrowseOodle" />
                            <Button DockPanel.Dock="Right" Content="Download" Margin="4,0,0,0" Padding="8,2" Click="DownloadOodle" />
                            <TextBox x:Name="OodleBox" />
                        </DockPanel>

                        <TextBlock FontWeight="Bold" Text="Game text language" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray">
                            The language Cardinal shows the game's own text in: item names in Tables, dialogue and names in Scripts.
                            All the game's languages are listed once its files are open. Changing it opens them again.
                        </TextBlock>
                        <ComboBox x:Name="LanguageBox" Margin="0,4,0,16" Width="280" HorizontalAlignment="Left" DisplayMemberPath="Name"
                                  SelectionChanged="LanguageSelected" />

                        <Button x:Name="OpenButton" Content="Save and open the game files" HorizontalAlignment="Left" Padding="12,4" Click="OpenGame" />
                        <TextBlock x:Name="SetupProblems" TextWrapping="Wrap" Foreground="Firebrick" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tables" x:Name="TablesTab" IsEnabled="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="TableList" SelectionChanged="TableSelected" DisplayMemberPath="Name">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,2" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="4">
                            <Button DockPanel.Dock="Right" Content="Export all tables..." Margin="4,0,0,0" Padding="8,2" Click="ExportAllTables" />
                            <Button DockPanel.Dock="Right" Content="Export this table..." Margin="4,0,0,0" Padding="8,2" Click="ExportTable" />
                            <Button x:Name="NewItemButton" DockPanel.Dock="Right" Content="New item from this row..." Margin="4,0,0,0" Padding="8,2"
                                    Click="NewItemClicked" Visibility="Collapsed"
                                    ToolTip="Adds a new item to your mod that starts as a copy of the selected one, with its own ID, name and description." />
                            <Button x:Name="NewTownButton" DockPanel.Dock="Right" Content="New town from this row..." Margin="4,0,0,0" Padding="8,2"
                                    Click="NewTownClicked" Visibility="Collapsed"
                                    ToolTip="Adds a new town to your mod that starts as a copy of the selected one, with its own ID and name in the warp list." />
                            <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="SearchBox" TextChanged="SearchChanged" />
                        </DockPanel>
                        <TextBlock x:Name="TableInfo" DockPanel.Dock="Top" Margin="6,0,6,0" Foreground="Gray" />
                        <TextBlock x:Name="EditInfo" DockPanel.Dock="Top" Margin="6,0,6,4" Foreground="Gray" TextWrapping="Wrap" />
                        <DataGrid x:Name="Grid" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                                  BeginningEdit="CellEditStarting" CellEditEnding="CellEdited" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Scripts" x:Name="ScriptsTab" IsEnabled="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4">
                            <TextBlock DockPanel.Dock="Left" Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="ScriptSearchBox" TextChanged="ScriptSearchChanged"
                                     ToolTip="Shows the scripts whose folder or name contains this, such as Tutorial or pev_01_01." />
                        </DockPanel>
                        <ListBox x:Name="ScriptList" SelectionChanged="ScriptSelected" DisplayMemberPath="Name">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,2" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="6,4,6,0">
                            <CheckBox x:Name="TechnicalBox" DockPanel.Dock="Right" Content="Technical view" Margin="12,0,0,0" Click="ScriptViewChanged"
                                      ToolTip="Shows every step with its class, raw settings and id, as a step change in a project refers to them." />
                            <CheckBox x:Name="NamesBox" DockPanel.Dock="Right" Content="Show real names" Margin="12,0,0,0" Click="ScriptViewChanged"
                                      ToolTip="Off, a cast member shows as their number until the subtitles first name them, as a scene often calls someone by a title before saying who they are. On, everyone is named from the game's own cast data from the start, as in Stella (4018), which can spoil that." />
                            <CheckBox x:Name="StagingBox" DockPanel.Dock="Right" Content="Show staging" Click="ScriptViewChanged"
                                      ToolTip="Also shows the steps that only stage a scene: camera moves, animations, looks, fades and waits." />
                            <TextBlock x:Name="ScriptInfo" Foreground="Gray" TextWrapping="Wrap"
                                       Text="The game's scripts for story events, quests and tutorials. Pick one to see what happens in it." />
                        </DockPanel>
                        <DataGrid x:Name="StepGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,4,0,0"
                                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit this line in the Text tab" Click="EditLine" />
                                    <MenuItem Header="Copy step id" Click="CopyStepId" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Edited}" Value="True">
                                            <Setter Property="Background" Value="#FFEC96" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Resources>
                                <Style x:Key="Wrapped" TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40" />
                                <DataGridTextColumn x:Name="WhatColumn" Header="What happens" Binding="{Binding Text}" Width="*"
                                                    ElementStyle="{StaticResource Wrapped}" />
                                <DataGridTextColumn x:Name="ThenColumn" Header="Then" Binding="{Binding Then}" Width="160"
                                                    ElementStyle="{StaticResource Wrapped}" />
                                <DataGridTextColumn x:Name="KindColumn" Header="Step" Binding="{Binding Kind}" Width="200" Visibility="Collapsed" />
                                <DataGridTextColumn x:Name="SettingsColumn" Header="Settings" Binding="{Binding Settings}" Width="*"
                                                    ElementStyle="{StaticResource Wrapped}" Visibility="Collapsed" />
                                <DataGridTextColumn x:Name="LeadsColumn" Header="Leads to" Binding="{Binding Leads}" Width="240"
                                                    ElementStyle="{StaticResource Wrapped}" Visibility="Collapsed" />
                                <DataGridTextColumn x:Name="IdColumn" Header="Step id" Binding="{Binding Id}" Width="290" FontFamily="Consolas"
                                                    Visibility="Collapsed" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Text" x:Name="TextTab" IsEnabled="False">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4">
                        <TextBlock DockPanel.Dock="Left" Text="Language" VerticalAlignment="Center" Margin="2,0,6,0" />
                        <ComboBox x:Name="CultureBox" DockPanel.Dock="Left" Width="240" SelectionChanged="CultureSelected" DisplayMemberPath="Name" />
                        <Button DockPanel.Dock="Right" Content="Import translation..." Margin="4,0,0,0" Padding="8,2" Click="ImportTranslation" />
                        <Button DockPanel.Dock="Right" Content="Export for translating..." Margin="4,0,0,0" Padding="8,2" Click="ExportTranslation" />
                        <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <TextBox x:Name="TextSearchBox" TextChanged="TextSearchChanged" />
                    </DockPanel>
                    <TextBlock x:Name="TextInfo" DockPanel.Dock="Top" Margin="6,0,6,4" Foreground="Gray" TextWrapping="Wrap" />
                    <DataGrid x:Name="TextGrid" AutoGenerateColumns="False" EnableRowVirtualization="True"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="Cell"
                              CellEditEnding="TextEdited">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace, Mode=OneWay}" IsReadOnly="True" Width="180" />
                            <DataGridTextColumn Header="Key" Binding="{Binding Key, Mode=OneWay}" IsReadOnly="True" Width="220" />
                            <DataGridTextColumn Header="English" Binding="{Binding English, Mode=OneWay}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Changed}" Value="True">
                                                <Setter Property="Background" Value="#FFEC96" />
                                                <Setter Property="Foreground" Value="Black" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Map" x:Name="MapTab" IsEnabled="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Floor" FontWeight="Bold" />
                            <ComboBox x:Name="FloorBox" Margin="0,2,0,8" SelectionChanged="FloorSelected" />
                            <TextBlock Text="Grid" FontWeight="Bold" />
                            <ComboBox x:Name="GridBox" Margin="0,2,0,8" SelectionChanged="GridSelected" />
                            <TextBlock Text="Grid level" FontWeight="Bold" />
                            <ComboBox x:Name="LevelBox" Margin="0,2,0,8" SelectionChanged="LevelSelected" />
                            <Button Content="Export this floor..." Padding="8,2" Margin="0,0,0,8" Click="ExportMap" />
                            <CheckBox x:Name="ModCellsBox" Content="Show cells installed mods replace" Margin="0,0,0,4"
                                      Checked="ModCellsToggled" Unchecked="ModCellsToggled" />
                            <StackPanel x:Name="ModLegend" Margin="16,0,0,8" />
                            <TextBlock Text="Layers" FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,4"
                                       Text="Developer layers are the level designers' notes left in the game. Showing them here never changes the game." />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LayerList" />
                        </ScrollViewer>
                    </DockPanel>
                    <Border Grid.Column="1" Background="#1B1B1F" ClipToBounds="True">
                        <local:MapView x:Name="Map" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Mod" x:Name="ModTab" IsEnabled="False">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8">
                        Edit values in the Tables tab and text in the Text tab (double-click a cell), or add new items from the Tables tab,
                        and they collect here. A project only
                        stores your changes, so it can be rebuilt after a game update, and every build starts from the unmodded game.
                        Changed text goes in with the rest of that language's lines, so rebuild text mods after every game update.
                    </TextBlock>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <TextBox x:Name="ModNameBox" Grid.Column="1" Margin="0,2,12,2" TextChanged="ModDetailsChanged" />
                        <TextBlock Text="Version" Grid.Column="2" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <TextBox x:Name="ModVersionBox" Grid.Column="3" Margin="0,2,0,2" TextChanged="ModDetailsChanged" />
                        <TextBlock Text="Author" Grid.Row="1" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <TextBox x:Name="ModAuthorBox" Grid.Row="1" Grid.Column="1" Margin="0,2,12,2" TextChanged="ModDetailsChanged" />
                        <TextBlock Text="Description" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <TextBox x:Name="ModDescriptionBox" Grid.Row="1" Grid.Column="3" Margin="0,2,0,2" TextChanged="ModDetailsChanged" />
                        <TextBlock Text="Priority" Grid.Row="2" VerticalAlignment="Center" Margin="0,2,6,2" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,2">
                            <TextBox x:Name="ModPriorityBox" Width="60" TextChanged="ModDetailsChanged" />
                            <TextBlock Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="1 to 9998. When two mods replace the same game file, the higher priority wins. Merging them is better than relying on it." />
                        </DockPanel>
                    </Grid>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="New project" Padding="8,2" Margin="0,0,4,4" Click="NewProject" />
                        <Button Content="Open project..." Padding="8,2" Margin="0,0,4,4" Click="OpenProject" />
                        <Button Content="Save project" Padding="8,2" Margin="0,0,4,4" Click="SaveProject" />
                        <Button Content="Save project as..." Padding="8,2" Margin="0,0,16,4" Click="SaveProjectAs" />
                        <Button Content="Revert selected" Padding="8,2" Margin="0,0,4,4" Click="RevertSelected" />
                        <Button Content="Check against the game" Padding="8,2" Margin="0,0,16,4" Click="CheckProject"
                                ToolTip="After a game update, shows changes that can't be made any more and values the update changed." />
                        <Button Content="Build mod into a folder..." Padding="8,2" Margin="0,0,4,4" Click="BuildToFolder" />
                        <Button Content="Build and install into ~mods" Padding="8,2" Margin="0,0,4,4" Click="BuildAndInstall" />
                    </WrapPanel>
                    <TextBlock x:Name="ModInfo" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,4" />
                    <TextBox x:Name="CheckResults" DockPanel.Dock="Bottom" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed" />
                    <ListView x:Name="EditList" SelectionMode="Extended">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Kind" Width="60" DisplayMemberBinding="{Binding Kind}" />
                                <GridViewColumn Header="What" Width="480" DisplayMemberBinding="{Binding What}" />
                                <GridViewColumn Header="Original" Width="240" DisplayMemberBinding="{Binding Original}" />
                                <GridViewColumn Header="New value" Width="240" DisplayMemberBinding="{Binding Value}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Merge" x:Name="MergeTab" IsEnabled="False">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8">
                        Mods that change the same game file replace each other, so only one of them works. Merging builds one patch from
                        all of their changes instead. Text mods always need it, since each one replaces a whole language.
                        Where two set the same value or line, the one lower in the list wins. The merged patch has the
                        top priority, so it wins over the mods it was made from.
                    </TextBlock>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Add projects..." Padding="8,2" Margin="0,0,4,4" Click="AddMergeProjects" />
                        <Button Content="Remove" Padding="8,2" Margin="0,0,4,4" Click="RemoveMergeProject" />
                        <Button Content="Move up" Padding="8,2" Margin="0,0,4,4" Click="MoveMergeUp" />
                        <Button Content="Move down" Padding="8,2" Margin="0,0,16,4" Click="MoveMergeDown" />
                        <Button Content="Build merged patch into a folder..." Padding="8,2" Margin="0,0,4,4" Click="BuildMergedToFolder" />
                        <Button Content="Build and install merged patch" Padding="8,2" Margin="0,0,4,4" Click="InstallMerged" />
                    </WrapPanel>
                    <TextBlock x:Name="MergeInfo" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="MergeList" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Order" Width="50" DisplayMemberBinding="{Binding Order}" />
                                    <GridViewColumn Header="Mod" Width="200" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Version" Width="80" DisplayMemberBinding="{Binding Version}" />
                                    <GridViewColumn Header="Changes" Width="70" DisplayMemberBinding="{Binding Changes}" />
                                    <GridViewColumn Header="Project file" Width="520" DisplayMemberBinding="{Binding Path}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="1" Text="Values and text more than one mod sets" FontWeight="Bold" Margin="0,8,0,4" />
                        <ListView x:Name="ClashList" Grid.Row="2">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="What" Width="520" DisplayMemberBinding="{Binding Change}" />
                                    <GridViewColumn Header="Values" Width="360" DisplayMemberBinding="{Binding Values}" />
                                    <GridViewColumn Header="Wins" Width="140" DisplayMemberBinding="{Binding Winner}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Installed mods" x:Name="InstalledTab" IsEnabled="False">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8">
                        Every mod in the Paks folder, made with Cardinal or not, and the game files more than one of them replaces.
                        When two replace the same file, the game loads only one copy: the one with the higher priority, the number before _P
                        in its name. Equal priorities leave it to chance, and a name ending in just _P ties with the game's own update.
                    </TextBlock>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Scan installed mods" Padding="8,2" Margin="0,0,4,4" Click="ScanInstalled" />
                        <Button Content="Patch new assets" Padding="8,2" Margin="0,0,4,4" Click="PatchRegistry"
                                ToolTip="Mods that add new things, like towns, need this after you install or remove them, so the game finds every one of them. It only takes a moment." />
                    </WrapPanel>
                    <TextBlock x:Name="InstalledInfo" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Mods" FontWeight="Bold" Margin="0,0,0,4" />
                        <ListView x:Name="InstalledList" Grid.Row="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Mod" Width="320" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Game files" Width="90" DisplayMemberBinding="{Binding Files}" />
                                    <GridViewColumn Header="In conflict" Width="90" DisplayMemberBinding="{Binding Conflicts}" />
                                    <GridViewColumn Header="Never used" Width="90" DisplayMemberBinding="{Binding Unused}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="2" Text="Conflicts" FontWeight="Bold" Margin="0,8,0,4" />
                        <ListView x:Name="ConflictList" Grid.Row="3">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Game file" Width="520" DisplayMemberBinding="{Binding Asset}" />
                                    <GridViewColumn Header="What happens" Width="620" DisplayMemberBinding="{Binding Outcome}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
