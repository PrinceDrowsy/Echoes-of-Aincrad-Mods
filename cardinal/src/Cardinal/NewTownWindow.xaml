<Window x:Class="Cardinal.NewTownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New town" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock FontWeight="Bold" Text="Town ID" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="Towns are told apart by their ID, which also names the town's asset. The next free one is filled in." />
        <TextBox x:Name="IdBox" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left" />

        <TextBlock FontWeight="Bold" Text="Name (English)" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="Shown in the warp list. Translate it on the Text tab like any other line." />
        <TextBox x:Name="NameBox" Margin="0,4,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add to the mod" IsDefault="True" Padding="12,4" Margin="0,0,8,0" Click="AddClicked" />
            <Button Content="Cancel" IsCancel="True" Padding="12,4" />
        </StackPanel>
    </StackPanel>
</Window>
